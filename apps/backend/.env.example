# App Config
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1
APP_NAME=Yewi Marketplace API

# Database (PostgreSQL with PostGIS)
DATABASE_URL=postgresql://yewi_user:yewi_secure_pass@localhost:5434/yewi_db?schema=public
DB_PORT=5434

# Redis (URL directa o Host/Port)
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & JWT
JWT_SECRET=your_jwt_access_secret_key_here
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRATION=7d

# Throttling & Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# CORS (Permite Web, Móvil y Expo)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:8081,http://localhost:19006

# Business Rules
PLATFORM_COMMISSION_PERCENTAGE=15
MAX_PROS_PER_LEAD=5
AUTO_COMPLETE_ORDER_DAYS=3
DEFAULT_CREDIT_PRICE_EUR=1.0

# Stripe (Payments & Escrow)
STRIPE_SECRET_KEY=sk_test_placeholder_yewi_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_yewi_stripe_webhook
STRIPE_PRO_PRICE_ID=price_placeholder_yewi_pro_monthly

# Storage (local / s3 / cloudinary)
# En Render / producción efímera se recomienda STORAGE_DRIVER=cloudinary para no perder archivos entre deploys
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads

# Cloudinary (Media / Avatars / Portfolios)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google OAuth & Identity
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
GOOGLE_CLIENT_IDS=your_android_client_id,your_ios_client_id,your_web_client_id

# Clerk Identity (App Móvil / Opcional)
CLERK_SECRET_KEY=sk_test_placeholder_clerk_secret_key
CLERK_JWKS_URL=https://api.clerk.com/v1/jwks
CLERK_ISSUER=https://clerk.yourdomain.com
CLERK_AUTHORIZED_PARTY=

# Swagger & Public App URL
ENABLE_SWAGGER=false
PUBLIC_APP_URL=https://yewi.app

# SMS OTP Provider (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

